# Copy to cloud.env; never commit the real file. These are independent of local .env.
RESOLVER_API_KEY=
RESOLVER_EMBED_HOSTS=
RESOLVER_MEDIA_HOSTS=
BIGPLAYS_PORT=8000
LEAGUES=["nba","nfl","ncaaf","mlb"]
ESPN_POLL_SECONDS=5
AGENT_MAX_GAMES=2
AGENT_BUFFER_MINUTES=30
AGENT_BUFFER_MAX_MB=2048

# Preserve fan-reaction approval. Automatic clips WAIT until Reddit works.
SOCIAL_CLIP_GATE=true
REDDIT_ENABLED=true
REDDIT_SOURCE=api
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_REFRESH_TOKEN=
REDDIT_USER_AGENT=bigplays-agent/0.1
REDDIT_POLL_SECONDS=30

# Start the local-llm profile and pull this model as described in docs/cloud.md.
USE_LLM=true
SOCIAL_LLM_PROVIDER=ollama
SOCIAL_LLM_MODEL=qwen3:4b
SOCIAL_LLM_CALLS_PER_HOUR=40
ANTHROPIC_API_KEY=
