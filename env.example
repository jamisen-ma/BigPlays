# Core
LEAGUES=nba,nfl
ESPN_POLL_SECONDS=5

# LLM
USE_LLM=true
ANTHROPIC_API_KEY=
LLM_MODEL=claude-3-5-sonnet-20240620

# Media
STREAM_URL=
BUFFER_DIR=data/buffer
CLIPS_DIR=data/clips
PRE_ROLL_SECONDS=8
POST_ROLL_SECONDS=6

# Storage
ENABLE_S3=false
S3_BUCKET=
S3_PREFIX=highlights/
AWS_DEFAULT_REGION=us-east-1

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Reddit (optional)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=bigplays-agent/0.1
REDDIT_ENABLED=false

