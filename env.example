# Core
LEAGUES=["nba","nfl","ncaaf","mlb"]
ESPN_POLL_SECONDS=5

# LLM
USE_LLM=true
ANTHROPIC_API_KEY=
LLM_MODEL=claude-3-5-sonnet-20240620

# Media
STREAM_URL=
BUFFER_DIR=data/buffer
CLIPS_DIR=data/clips
PRE_ROLL_SECONDS=8
POST_ROLL_SECONDS=6

# Persistent play monitor (the agent process in process-compose.yaml).
AGENT_DIR=data/agent
AGENT_MAX_GAMES=2
AGENT_BUFFER_MINUTES=30
AGENT_BUFFER_MAX_MB=2048
AGENT_PRE_ROLL_SECONDS=12
AGENT_POST_ROLL_SECONDS=4
# Built automatically from scripts/scoreboard_ocr.swift on macOS.
# Linux cloud containers use tesseract (included in Dockerfile).
SCOREBOARD_OCR_BIN=data/tools/scoreboard-ocr

# Storage
MLB_HIGHLIGHTS_ENABLED=false
MLB_HIGHLIGHTS_POLL_SECONDS=60
# SQLite defaults to a sibling of CLIPS_DIR: data/clips.sqlite3.
# Video files remain in CLIPS_DIR. Persist both the database and video directory.
# DATABASE_PATH=data/clips.sqlite3
ENABLE_S3=false
S3_BUCKET=
S3_PREFIX=highlights/
AWS_DEFAULT_REGION=us-east-1

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Reddit (optional)
# Clip gate. Manual cuts (POST /api/agent/clip) always bypass it.
#   off    = no gate: every play passing the initial filter is published at cut (false/0 also mean off).
#   hype   = cut, hold, publish on fan hype (the default; true/1 also mean hype). Clips are cut exactly as
#            with off, but saved PENDING in <CLIPS_DIR>-pending/ (not in the catalog, /api/highlights,
#            /api/games, /clips or SSE) until the gate decides from the play's Reddit game-thread comments:
#            heuristics (ALL CAPS, OMGGGG, hype words, team cheers, emoji, burst vs the previous 10 min)
#            AND the local LLM (SOCIAL_LLM_*). Approved -> published at once. Can't-miss plays (home runs,
#            walk-offs, 7th+ go-ahead/tying runs, grand slams, football TDs/turnovers) and leagues without
#            Reddit RSS coverage publish at cut. No Reddit data -> published per the initial filter.
#   legacy = the older approve-before-cut judge over REDDIT_SOURCE (OAuth/browser) comments.
SOCIAL_CLIP_GATE=hype
# Reaction window after the play appears on the broadcast (ESPN wallclock + measured video offset):
# [anchor - PRE, anchor + WINDOW]. The gate then asks the server's RSS poller for a priority poll.
SOCIAL_HYPE_WINDOW_SECONDS=30
SOCIAL_HYPE_PRE_SECONDS=5
# Publish per the initial filter if no Reddit data covers the window this long after it closes (+5 s).
SOCIAL_HYPE_FALLBACK_SECONDS=90
# Rejected held clips stay in <CLIPS_DIR>-pending/ for manual override, then are deleted (published clips never).
SOCIAL_HYPE_PENDING_TTL_HOURS=6
# Heuristic pre-score (0-1) needed before asking the LLM; the LLM must also say viral.
SOCIAL_HYPE_THRESHOLD=0.45
# Heuristics-only bar used when the LLM is unavailable (down, timed out, malformed reply, budget spent).
SOCIAL_HYPE_STRICT_THRESHOLD=0.7
SOCIAL_HYPE_LLM_TIMEOUT_SECONDS=20
# browser = public Chrome DOM; access blocks hold clips. api = approved OAuth access.
REDDIT_SOURCE=browser
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_REFRESH_TOKEN=
REDDIT_USER_AGENT=bigplays-agent/0.1
REDDIT_ENABLED=false
REDDIT_POLL_SECONDS=15
# Game-thread fan reactions from Reddit's official public RSS feeds (no credentials).
# One shared queue honors x-ratelimit-*/Retry-After, spaces requests >= the minimum
# interval and backs off exponentially on 429s/errors.
REDDIT_RSS_ENABLED=true
REDDIT_RSS_USER_AGENT=BigPlays/0.1 (personal sports reactions reader)
REDDIT_RSS_MIN_INTERVAL_SECONDS=30
REDDIT_RSS_MAX_GAMES=3
REDDIT_RSS_MAX_THREADS=3
REDDIT_RSS_STATE_PATH=data/social/reddit_rss.json
# Social ranking uses a small model independently of the legacy LLM_MODEL setting.
# The hype gate supports ollama only (thinking disabled, strict JSON); others count as LLM unavailable.
SOCIAL_LLM_PROVIDER=ollama
SOCIAL_LLM_MODEL=qwen3:4b
OLLAMA_BASE_URL=http://127.0.0.1:11434
SOCIAL_LLM_CALLS_PER_HOUR=40


# Demo mode (no live games needed)
DEMO_MODE=false
# Limit historical replay to one league: all, nba, nfl
DEMO_LEAGUE=all
# Verified footage catalog (prepare with python -m bigplays.demo.prepare_week3)
DEMO_DATASET=highlights
DEMO_CLIPS_DIR=data/demo_clips
DEMO_MIN_INTERVAL=7
DEMO_MAX_INTERVAL=14

# Private Node resolver; use the same random key in both processes.
RESOLVER_BASE_URL=http://127.0.0.1:3000
RESOLVER_API_KEY=
# Exact approved hostnames, comma-separated; no wildcards. Empty denies all.
RESOLVER_EMBED_HOSTS=
RESOLVER_MEDIA_HOSTS=
